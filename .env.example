# Server-only Neon pooled PostgreSQL URL. Do not prefix with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Generate once with: openssl rand -base64 48. Keep stable across deploys.
BETTER_AUTH_SECRET=
CRM_ADMIN_EMAIL=admin@example.com
# Used only when initializing a new workspace (12–1024 characters).
CRM_ADMIN_PASSWORD=
CRM_ORIGIN=http://localhost:3000
PORT=3001
CRM_HOST=127.0.0.1
# One-time legacy import only (optional):
# CRM_SQLITE_PATH=/absolute/path/to/crm.sqlite

# Optional build-time canonical origin for the static marketing pages
# PUBLIC_SITE_URL=https://glasscrm.onrender.com
